APP_NAME=Farmaura API
APP_ENV=development
APP_HOST=0.0.0.0
APP_PORT=8080
APP_BASE_URL=https://api.farmaura.local
APP_API_V1_PREFIX=/api/v1
APP_DEBUG=false
APP_ALLOWED_ORIGINS=https://farmaura.local,https://farmacia.local
APP_DATABASE_URL=postgresql+psycopg://farmaura:farmaura@postgres:5432/farmaura
APP_VALKEY_URL=valkey://valkey:6379/0
APP_JWT_ISSUER=farmaura-api
APP_JWT_AUDIENCE=farmaura-clients
APP_JWT_ACCESS_TTL_MINUTES=15
APP_JWT_REFRESH_TTL_DAYS=30
APP_JWT_PRIVATE_KEY=change-me
APP_JWT_PUBLIC_KEY=change-me
APP_JWT_ALGORITHM=HS256
# Google Cloud Console -> APIs e serviços -> Credenciais -> ID do cliente OAuth (Aplicativo da
# Web). Não é um segredo (fica visível no navegador), mas nunca colar aqui o valor real do
# ambiente de produção — cada dev/ambiente usa o Client ID do seu próprio projeto/origens.
APP_GOOGLE_OAUTH_CLIENT_ID=
APP_STORAGE_ROOT=backend/storage/private
APP_STORAGE_TMP_ROOT=backend/storage/tmp
APP_STORAGE_QUARANTINE_ROOT=backend/storage/quarantine
APP_MAX_REQUEST_BODY_BYTES=1048576
APP_MAX_UPLOAD_BYTES=5242880
APP_DEFAULT_PAGE_SIZE=20
APP_MAX_PAGE_SIZE=100
APP_GEOCODING_ENABLED=true
APP_GEOCODING_BASE_URL=https://nominatim.openstreetmap.org
APP_GEOCODING_USER_AGENT=farmaura-api/1.0 (contato@suaempresa.com.br)
APP_ROUTING_ENABLED=true
APP_ROUTING_BASE_URL=https://router.project-osrm.org
APP_STORE_HUB_NAME=
APP_STORE_HUB_ADDRESS=

# Single production admin account created on first boot when APP_ENV=production
# and the users table is empty (see scripts/production_admin.py). Ignored in
# development, where scripts/seed.py's fictional dataset is used instead.
APP_INITIAL_ADMIN_EMAIL=
APP_INITIAL_ADMIN_PASSWORD=

# ---------------------------------------------------------------------------------------------
# Fiscal module — NFC-e model 65, Distrito Federal (SVRS). See farmaura-api/docs/fiscal/NFCE.md
# NEVER put a real CSC, certificate password or certificate file in this file or in git.
# ---------------------------------------------------------------------------------------------
# Master switch. false = the PDV sells normally and no fiscal document is created.
NFCE_ENABLED=false
# homologacao (default) or producao. Production ALSO needs FISCAL_PRODUCTION_ENABLED=true,
# otherwise the fiscal module refuses to emit.
FISCAL_ENV=homologacao
FISCAL_PRODUCTION_ENABLED=false
# Optional; when set it must equal FISCAL_ENV (a mismatch is treated as a configuration error).
NFCE_ENV=

# Emitter (the establishment that issues the note). Every field below is REQUIRED to emit.
NFCE_CNPJ=
NFCE_IE=
NFCE_RAZAO_SOCIAL=
NFCE_NOME_FANTASIA=FARMAURA
# 1=Simples Nacional, 2=Simples excesso de sublimite, 3=Regime Normal, 4=MEI (ask the accountant).
# CRT=3 makes IBS/CBS fields mandatory (NT 2025.002 v1.51).
NFCE_CRT=
NFCE_LOGRADOURO=
NFCE_NUMERO=
NFCE_COMPLEMENTO=
NFCE_BAIRRO=
NFCE_CEP=
NFCE_MUNICIPIO=
NFCE_CODIGO_IBGE_MUNICIPIO=
NFCE_TELEFONE=
NFCE_SERIE=

# CSC is NOT used by QR Code v3 online emission (NT 2025.001). Kept only for a rollback to QR Code v2.
NFCE_CSC_ID_HOMOLOGACAO=
NFCE_CSC_HOMOLOGACAO=
NFCE_CSC_ID_PRODUCAO=
NFCE_CSC_PRODUCAO=

# A1 certificate (.pfx/.p12). In Docker the folder ./secrets/nfce is mounted read-only at /run/secrets/nfce.
NFCE_CERTIFICATE_PATH=
NFCE_CERTIFICATE_PASSWORD=
NFCE_CERTIFICATE_WARN_DAYS=30

# Operation
NFCE_CANCEL_WINDOW_MINUTES=30
NFCE_CONTINGENCY_ENABLED=false
NFCE_HTTP_TIMEOUT_SECONDS=20
NFCE_MAX_ATTEMPTS=6
# DF consultation URLs (confirm the homologation values on the first homologation answer).
NFCE_QRCODE_URL=http://www.fazenda.df.gov.br/nfce/qrcode
NFCE_CONSULTATION_URL=http://www.fazenda.df.gov.br/nfce/consulta
# Optional PEM bundle with the ICP-Brasil chain if the SEFAZ server certificate is not trusted by default.
NFCE_CA_BUNDLE_PATH=

# ---------------------------------------------------------------------------------------------
# Asaas — pagamentos (Pix/cartão) e nota de serviço. Passo a passo: dev-obsidian POP "testar-asaas-sandbox".
# Em dev/staging/docker use SEMPRE o sandbox. A produção (api.asaas.com) só funciona com APP_ENV=production;
# em qualquer outro ambiente o cliente recusa (evita cobrar cartão de verdade por engano).
# ---------------------------------------------------------------------------------------------
APP_ASAAS_ENABLED=false
APP_ASAAS_BASE_URL=https://api-sandbox.asaas.com
# Chave de API da conta SANDBOX (Asaas > Integrações > Chave de API; começa com $aact_hmlg_). Nunca versionar.
APP_ASAAS_ACCESS_TOKEN=
# Segredo do webhook (32-255 caracteres; ex.: python -c "import secrets; print(secrets.token_urlsafe(48))").
# O Asaas o devolve no header "asaas-access-token"; o mesmo valor é usado ao cadastrar o webhook.
APP_ASAAS_WEBHOOK_AUTH_TOKEN=
# Opcional: lista de IPs/CIDRs de origem permitidos (vazio = só o token valida).
APP_ASAAS_WEBHOOK_ALLOWED_IPS=

# Nota fiscal de serviço (NFS-e) agendada no Asaas após o pagamento do pedido do marketplace.
APP_ASAAS_INVOICE_ENABLED=false
# Use o id (GET /v3/fiscalInfo/services, ou scripts/asaas_sandbox_check.py --services) OU o código municipal.
APP_ASAAS_INVOICE_MUNICIPAL_SERVICE_ID=
APP_ASAAS_INVOICE_MUNICIPAL_SERVICE_CODE=
APP_ASAAS_INVOICE_MUNICIPAL_SERVICE_NAME=
APP_ASAAS_INVOICE_OBSERVATIONS=
APP_ASAAS_INVOICE_RETAIN_ISS=false
APP_ASAAS_INVOICE_ISS=0
APP_ASAAS_INVOICE_PIS=0
APP_ASAAS_INVOICE_COFINS=0
APP_ASAAS_INVOICE_CSLL=0
APP_ASAAS_INVOICE_INSS=0
APP_ASAAS_INVOICE_IR=0
# Dias entre a confirmação do pagamento e a emissão do documento fiscal do pedido online (padrão 7 = janela do CDC).
# Use 0 SOMENTE em sandbox/dev para testar a geração da nota sem esperar.
APP_FISCAL_ISSUANCE_DELAY_DAYS=7
